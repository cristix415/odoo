<odoo>
    <record id="view_modul_cristi_tree" model="ir.ui.view">
        <field name="name">modul.cristi.tree</field>
        <field name="model">modul.cristi</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="view_modul_cristi_form" model="ir.ui.view">
        <field name="name">modul.cristi.form</field>
        <field name="model">modul.cristi</field>
        <field name="arch" type="xml">
            <form string="Modul Cristi">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- The action for opening the model is defined in menu.xml to ensure it's available when menus are parsed -->
</odoo>
