<odoo>
    <record id="view_modul_cristi_list" model="ir.ui.view">
        <field name="name">modul.cristi.list</field>
        <field name="model">modul.cristi</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_modul_cristi_form" model="ir.ui.view">
        <field name="name">modul.cristi.form</field>
        <field name="model">modul.cristi</field>
        <field name="arch" type="xml">
            <form string="Modul Cristi">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_modul_cristi" model="ir.actions.act_window">
        <field name="name">Modul Cristi field 2222</field>
        <field name="res_model">modul.cristi</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Apasă "Creează" pentru a adăuga o înrddddddegistrare.</p>
        </field>
    </record>
</odoo>
